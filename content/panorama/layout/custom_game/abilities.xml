<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/abilities.css" />
	</styles> 
	<scripts>
		<include src="file://{resources}/scripts/custom_game/abilities.js" />
	</scripts>
	 <snippets>
		<snippet name="AbilityIconContainer">
			<DOTAAbilityImage hittest="true" class="AbilityIcon"/>
		</snippet>
		<snippet name="PerkContainer">
			<Panel hittest="true" class="Perk">
				<DOTAAbilityImage hittest="true" class="PerkAbilityIcon"/>
				<Label hittest="true" class="PerkLabel" text="Major Perk"/> 
			</Panel>
		</snippet>
	</snippets>
	<Panel class="AbilityRoot" hittest="false">
		<Panel id="AbilityIconRoot" class="AbilityIconRoot" hittest="false">
		</Panel>
		<Panel id="PerksRoot" class="PerksRoot" hittest="false">
		</Panel>
	</Panel>
</root>